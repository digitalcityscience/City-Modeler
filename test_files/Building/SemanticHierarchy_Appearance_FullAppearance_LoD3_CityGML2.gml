<bldg:boundedBy><bldg:WallSurface gml:id="SEMHIER_APP_FULL_WALL_V2"><gml:name>Wall (textured)</gml:name><bldg:lod3MultiSurface><gml:MultiSurface gml:id="SEMHIER_APP_FULL_WALL_V2_MS"><gml:surfaceMember><gml:Polygon gml:id="SEMHIER_APP_FULL_WALL_POLY_V2"><gml:exterior><gml:LinearRing gml:id="SEMHIER_APP_FULL_WALL_POLY_V2_0_"><gml:posList srsDimension="3">0 0 0 0 1 0 0 1 2 0 0 2 0 0 0</gml:posList></gml:LinearRing></gml:exterior></gml:Polygon></gml:surfaceMember></gml:MultiSurface></bldg:lod3MultiSurface><bldg:opening><bldg:Window gml:id="SEMHIER_APP_FULL_WINDOW_V2"><gml:name>Window (materialed)</gml:name><bldg:lod3MultiSurface><gml:MultiSurface gml:id="SEMHIER_APP_FULL_WINDOW_V2_MS"><gml:surfaceMember><gml:Polygon gml:id="SEMHIER_APP_FULL_WINDOW_POLY_V2"><gml:exterior><gml:LinearRing gml:id="SEMHIER_APP_FULL_WINDOW_POLY_V2_0_"><gml:posList srsDimension="3">0 0.3 0.3 0 0.7 0.3 0 0.7 1.3 0 0.3 1.3 0 0.3 0.3</gml:posList></gml:LinearRing></gml:exterior></gml:Polygon></gml:surfaceMember></gml:MultiSurface></bldg:lod3MultiSurface></bldg:Window></bldg:opening><bldg:opening><bldg:Door gml:id="SEMHIER_APP_FULL_DOOR_V2"><gml:name>Door (materialed)</gml:name><bldg:lod3MultiSurface><gml:MultiSurface gml:id="SEMHIER_APP_FULL_DOOR_V2_MS"><gml:surfaceMember><gml:Polygon gml:id="SEMHIER_APP_FULL_DOOR_POLY_V2"><gml:exterior><gml:LinearRing gml:id="SEMHIER_APP_FULL_DOOR_POLY_V2_0_"><gml:posList srsDimension="3">0 0.75 0 0 0.95 0 0 0.95 1 0 0.75 1 0 0.75 0</gml:posList></gml:LinearRing></gml:exterior></gml:Polygon></gml:surfaceMember></gml:MultiSurface></bldg:lod3MultiSurface></bldg:Door></bldg:opening></bldg:WallSurface></bldg:boundedBy>
