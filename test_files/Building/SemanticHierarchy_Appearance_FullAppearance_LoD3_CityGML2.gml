    </gml:Envelope>
  </gml:boundedBy>
  <cityObjectMember>
    <bldg:Building gml:id="SEMHIER_APP_FULL_BUILDING_V2">
      <gml:name>Semantic Hierarchy Appearance Fixture - Full Appearance</gml:name>

<bldg:outerBuildingInstallation><bldg:BuildingInstallation gml:id="SEMHIER_APP_FULL_INST_GENERIC_V2"><gml:name>Installation (materialed)</gml:name><bldg:lod3Geometry><gml:MultiSurface gml:id="SEMHIER_APP_FULL_INST_GENERIC_V2_MS_L3"><gml:surfaceMember><gml:Polygon gml:id="SEMHIER_APP_FULL_INST_GENERIC_POLY_V2"><gml:exterior><gml:LinearRing gml:id="SEMHIER_APP_FULL_INST_GENERIC_POLY_V2_0_"><gml:posList srsDimension="3">6 0 0 6 1 0 6 1 1 6 0 1 6 0 0</gml:posList></gml:LinearRing></gml:exterior></gml:Polygon></gml:surfaceMember></gml:MultiSurface></bldg:lod3Geometry></bldg:BuildingInstallation></bldg:outerBuildingInstallation>
<bldg:outerBuildingInstallation><bldg:BuildingInstallation gml:id="SEMHIER_APP_FULL_BALCONY_V2"><gml:name>Roof Accessory 1 (textured)</gml:name><bldg:class>5010</bldg:class><bldg:lod3Geometry><gml:MultiSurface gml:id="SEMHIER_APP_FULL_BALCONY_V2_MS_L3"><gml:surfaceMember><gml:Polygon gml:id="SEMHIER_APP_FULL_BALCONY_POLY_V2"><gml:exterior><gml:LinearRing gml:id="SEMHIER_APP_FULL_BALCONY_POLY_V2_0_"><gml:posList srsDimension="3">8 0 0 8 1 0 8 1 1 8 0 1 8 0 0</gml:posList></gml:LinearRing></gml:exterior></gml:Polygon></gml:surfaceMember></gml:MultiSurface></bldg:lod3Geometry></bldg:BuildingInstallation></bldg:outerBuildingInstallation>
