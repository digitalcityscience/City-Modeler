      <app:surfaceDataMember><app:ParameterizedTexture gml:id="SEMHIER_APP_FULL_WALL_TEX_V2"><app:isFront>true</app:isFront><app:imageURI>SemanticHierarchy_Appearance_facade.png</app:imageURI><app:target uri="#SEMHIER_APP_FULL_WALL_POLY_V2"><app:TexCoordList gml:id="SEMHIER_APP_FULL_WALL_TEX_V2_TCL"><app:textureCoordinates ring="#SEMHIER_APP_FULL_WALL_POLY_V2_0_">0 0 1 0 1 1 0 1 0 0</app:textureCoordinates></app:TexCoordList></app:target></app:ParameterizedTexture></app:surfaceDataMember>
