      <app:surfaceDataMember><app:X3DMaterial gml:id="SEMHIER_APP_FULL_GROUND_MAT_V2"><app:isFront>true</app:isFront><app:diffuseColor>0.4 0.4 0.4</app:diffuseColor><app:target>#SEMHIER_APP_FULL_GROUND_POLY_V2</app:target></app:X3DMaterial></app:surfaceDataMember>
      <app:surfaceDataMember><app:X3DMaterial gml:id="SEMHIER_APP_FULL_INST_GENERIC_MAT_V2"><app:isFront>true</app:isFront><app:diffuseColor>0.85 0.5 0.2</app:diffuseColor><app:target>#SEMHIER_APP_FULL_INST_GENERIC_POLY_V2</app:target></app:X3DMaterial></app:surfaceDataMember>
