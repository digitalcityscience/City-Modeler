      <app:surfaceDataMember><app:X3DMaterial gml:id="SEMHIER_APP_FULL_CHIMNEY_MAT_V2"><app:isFront>true</app:isFront><app:diffuseColor>0.3 0.2 0.15</app:diffuseColor><app:target>#SEMHIER_APP_FULL_CHIMNEY_POLY_V2</app:target></app:X3DMaterial></app:surfaceDataMember>
